  "cells": [
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "id": "QuwbDb0CM2Og"
      },
      "outputs": [],
      "source": [
        "!pip install -q sentence-transformers datasets transformers huggingface-hub accelerate\n",
        "\n",
        "from sentence_transformers import SentenceTransformer, InputExample, losses, util\n",
        "from torch.utils.data import DataLoader\n",
        "from datasets import load_dataset, Dataset, DatasetDict\n",
        "from huggingface_hub import login\n",
        "import torch, os, json, random\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "HF_TOKEN = \"your_token\"\n",
        "login(HF_TOKEN)\n",
        "HF_USERNAME = \"ij98\"  # e.g. \"imama\"\n"
      ],
      "metadata": {
        "id": "y-zGt3PGNY8U"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def make_pair(resume, jd, score):\n",
        "    return {\"resume\": resume, \"job\": jd, \"score\": float(score)}\n",
        "\n",
        "# Example resumes & job descriptions (replace with your real dataset)\n",
        "resumes = [\n",
        "    \"Experienced Python developer with 3 years in data analysis, pandas and scikit-learn, built ML pipelines.\",\n",
        "    \"NLP engineer experienced in transformers, Hugging Face, and fine-tuning language models.\",\n",
        "    \"Software engineer skilled in Java, Spring, and backend services; limited ML experience.\"\n",
        "]\n",
        "\n",
        "jobs = [\n",
        "    \"We need a Data Scientist skilled in Python, pandas, scikit-learn to build ML pipelines and analyze data.\",\n",
        "    \"Seeking an NLP Engineer with experience fine-tuning transformers and using Hugging Face.\",\n",
        "    \"Backend developer role requiring Java and Spring framework experience.\"\n",
        "]\n",
        "\n",
        "pairs = [\n",
        "    make_pair(resumes[0], jobs[0], 1.0),  # good match\n",
        "    make_pair(resumes[1], jobs[1], 1.0),\n",
        "    make_pair(resumes[2], jobs[2], 1.0),\n",
        "    make_pair(resumes[0], jobs[1], 0.2),  # not great match\n",
        "    make_pair(resumes[1], jobs[0], 0.3),\n",
        "    make_pair(resumes[2], jobs[0], 0.1)\n",
        "]\n",
        "\n",
        "dataset = Dataset.from_list(pairs).train_test_split(test_size=0.33, seed=42)\n",
        "dataset\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "SY7sM7n0OzKu",
        "outputId": "dc1424ce-2fb5-4a13-a6fa-b013f3cdb7c4"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "DatasetDict({\n",
              "    train: Dataset({\n",
              "        features: ['resume', 'job', 'score'],\n",
              "        num_rows: 4\n",
              "    })\n",
              "    test: Dataset({\n",
              "        features: ['resume', 'job', 'score'],\n",
              "        num_rows: 2\n",
              "    })\n",
              "})"
            ]
          },
          "metadata": {},
          "execution_count": 3
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def to_input_examples(ds):\n",
        "    examples = []\n",
        "    for row in ds:\n",
        "        # We will treat score as relevance; for contrastive training we create pairs: (resume, job) with label\n",
        "        examples.append(InputExample(texts=[row['resume'], row['job']], label=row['score']))\n",
        "    return examples\n",
        "\n",
        "train_examples = to_input_examples(dataset['train'])\n",
        "test_examples = to_input_examples(dataset['test'])\n",
        "len(train_examples), len(test_examples)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "CFl_42SQQN6O",
        "outputId": "ed3037cb-4945-41b8-c714-4f1d91a3898e"
      },
      "execution_count": 4,
